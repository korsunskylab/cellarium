# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/
.virtual_documents/
*.nbconvert.ipynb

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.python-version
.venv/
venv/

# Editors
.vscode/
.idea/

# Full Xenium source files (~3 GB) — only per-ROI crops are tracked.
data/Xenium_Prime_Human_Skin_FFPE_xe_outs/*
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/README.md

# Generic exclusions for any other Xenium dataset that might land here
data/**/morphology_focus/
data/**/*.zarr.zip
data/**/*.xenium
data/**/analysis_summary.html

# Derived outputs from the workflow notebooks — all regenerable
data/**/cells_extracted/
data/**/celltype_analysis*/
data/**/gene_celltype_*.parquet
data/**/gene_labels_*.parquet
data/**/ROI*/boundary_prior/
data/**/ROI*/cpsam_roundtrip/

# Keep data/README.md tracked
!data/README.md

# V0 batch outputs (regenerable, large)
pipelines/V0/out/

# Don't re-track folders we've removed
figs/
reports/
refs/

# Heavy WSI artefacts (regenerable from morphology + transcripts)
data/**/cpsam_whole_slide/
data/**/method_F_global_wsi/

# Editor scratch
.claude/scheduled_tasks.lock

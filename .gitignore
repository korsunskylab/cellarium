# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/
.virtual_documents/
*.nbconvert.ipynb

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.python-version
.venv/
venv/

# Editors
.vscode/
.idea/

# Full Xenium source files (~3 GB) — only per-ROI crops are tracked.
data/Xenium_Prime_Human_Skin_FFPE_xe_outs/*
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/README.md

# Generic exclusions for any other Xenium dataset that might land here
data/**/morphology_focus/
data/**/*.zarr.zip
data/**/*.xenium
data/**/analysis_summary.html

# Derived outputs from the workflow notebooks — all regenerable
data/**/cells_extracted/
data/**/celltype_analysis*/
data/**/gene_celltype_*.parquet
data/**/gene_labels_*.parquet
data/**/ROI*/boundary_prior/
data/**/ROI*/cpsam_roundtrip/

# Full, non-subsetted datasets — NEVER track these (GitHub 100 MB/file limit)
data/ITN_PAUSE/
data/MERSCOPE_*/

# Catch-all blocks for raw/multi-MB Xenium-shaped files that slip past
# directory rules above. The per-ROI cached crops are re-whitelisted below.
data/**/*.ome.tif
data/**/*.h5
data/**/*.mtx
data/**/*.mtx.gz
data/**/cell_boundaries.csv*
data/**/nucleus_boundaries.csv*
data/**/transcripts.csv*
data/**/detected_transcripts.csv*
data/**/mosaic_*.tif
data/**/gene_panel.json
data/**/cell_feature_matrix*
data/**/cells.zarr*
data/**/analysis*.zarr*

# Whitelist the per-ROI cached crops (subsetted, all < 5 MB)
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/morphology_*.tif
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/transcripts.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/cells_labeled.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/cells_10x_*.tif
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/ROI*/cells_10x_*.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/benchmark_doublets.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/benchmark_doublet_rois/*/morphology_*.tif
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/benchmark_doublet_rois/*/transcripts.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/benchmark_doublet_rois/*/cells_*.tif
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/benchmark_doublet_rois/*/cells_*.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/gene_labels_lineage.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/gene_celltype_*.parquet
!data/Xenium_Prime_Human_Skin_FFPE_xe_outs/cells_doublet_composition*.parquet

# Keep data/README.md tracked
!data/README.md

# V0 batch outputs (regenerable, large)
pipelines/V0/out/

# Don't re-track folders we've removed
figs/
reports/
refs/

# Heavy WSI artefacts (regenerable from morphology + transcripts)
data/**/cpsam_whole_slide/
data/**/method_F_global_wsi/

# Editor scratch
.claude/scheduled_tasks.lock
